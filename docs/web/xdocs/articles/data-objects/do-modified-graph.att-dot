digraph bomodified {
	
	node [shape=circle, style=filled, color=lightseagreen] {
		"M01"; "M02"; 
		"M011"
	};

	node [shape=circle, stype=filled, fillcolor=white, color=black] {
		"C0"; 
		"C03"; 
		"C0343"
	};

	node [shape=circle, style=filled, color=lightgray] {
		"I01A"; "I02B"; 
		"I01AA"
	};
	
	node [shape=circle, style=dotted, fillcolor=white, color=black] {
		"D012"; "D023";  
		"D0122"
	};
	
	C0 -> M01; C0 -> M02; C0 -> C03

	M01 -> M011; M01 -> D012 [style = dotted]; M01 -> I01A;
	M02 -> D023 [style = dotted, color=lightgray]; M02 -> I02B;
	C03 -> U034;

	D012 -> D0122 [style = dotted, color=lightgray];	
	I01A -> I01AA; 
	U034 -> C0343;
};
	
