#emitFileHeader()

package ${package.getAttribute("ejb-server-package")};

import java.rmi.RemoteException;
import javax.ejb.CreateException;

#set($serverName=${package.valueOfTag("ejb-server-name")})
#set($className="${serverName}Home")
/** 
 * The class implements the home interface of the ${serverName} session bean
 * as defined in the EJB standard.
 */
public interface ${className} extends javax.ejb.EJBHome {
  /**
   * Creates the remote session for the ${serverName}.
   * @throws RemoteException if a communication error occured
   * @throws CreateException if the remote session could not be created
   */
  ${serverName}Session create() throws RemoteException, CreateException;
}
