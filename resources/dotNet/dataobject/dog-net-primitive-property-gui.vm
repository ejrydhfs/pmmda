    private void ${textBoxName}_TextChanged(object sender, System.EventArgs e)
    {
      if (${doFieldName} != null) 
      {
        m_propertyValueChanged = true;
      }
    }
    
    private void ${textBoxName}_KeyPress(object sender, System.Windows.Forms.KeyPressEventArgs e)
    {
      if (${doFieldName} != null) 
      {
        if (e.KeyChar == (char) Keys.Enter) 
        {
          Update${propertyName}();
        }
        if (e.KeyChar == (char) Keys.Escape) 
        {
          m_propertyValueChanged = false;
          Update${propertyName}();
        }
      }
    }

    private void ${textBoxName}_Leave(object sender, System.EventArgs e)
    {
      Update${propertyName}();
    }
    
    private void Update${propertyName}()
    {
      if (m_propertyValueChanged)
      {
        try
        {
#if($propertyType=="string")
          ${doFieldName}.${propertyName} = ${textBoxName}.Text;
#else
          ${doFieldName}.${propertyName} = ${propertyType}.Parse(${textBoxName}.Text);
#end
          m_propertyValueChanged = false;
        }
        catch (Exception ex)
        {
          if (DialogResult.Cancel == MessageBox.Show(this, ${quotes}Could not set the property ${propertyName} to \\${quotes}${quotes} + ${textBoxName}.Text + ${quotes}\\${quotes}. Error: ${quotes} + ex.Message, ${quotes}Setting property value failed${quotes}, MessageBoxButtons.OKCancel, MessageBoxIcon.Error, MessageBoxDefaultButton.Button1))
          {
            m_propertyValueChanged = false;
            Read${propertyName}FromPd();
          }
          if (${textBoxName}.Focus())
          {
            ${textBoxName}.SelectionStart = 0;
            ${textBoxName}.SelectionLength = ${textBoxName}.Text.Length;
          }
        }
      }
      else
      {
        Read${propertyName}FromPd();
      }
    }
    
    private void Read${propertyName}FromPd()
    {
#if(${propertyType.equals("string")})
      if (${doFieldName}.${propertyName} != null)
      {
        ${textBoxName}.Text = ${doFieldName}.${propertyName};
      }
      else
      {
        ${textBoxName}.Text = string.Empty;
      }
#else
      ${textBoxName}.Text = ${doFieldName}.${propertyName}.ToString();
#end
    }
