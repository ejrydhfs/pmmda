${spaces}  /// <summary>
${spaces}  /// Implements the visitor pattern in the lightweight object class. The accept
${spaces}  /// method dispatches the visitor to all its relevant children. A relevant
${spaces}  /// child is always another data object.
${spaces}  /// </summary>
${spaces}  /// <param name=${quotes}visitor${quotes}>Visitor to act on the lightweight object.</param>
${spaces}  public void Accept(ILwVisitor visitor) {
${spaces}    visitor.Depth++;
${spaces}    AcceptIndexedProperties(visitor);
${spaces}    visitor.Visit(this);
${spaces}    AcceptProperties(visitor);
${spaces}    visitor.Depth--;
${spaces}  }
#end
