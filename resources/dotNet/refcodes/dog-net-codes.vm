${spaces}  
${spaces}  private static void SetCodes(IReferenceCode[] referenceCodes) {
${spaces}    bool hasChanged = false;
${spaces}    foreach (IReferenceCode referenceCode in referenceCodes) {
${spaces}      if(m_codes.ContainsKey(referenceCode.Code)) {continue;}
${spaces}      m_codes.Add(referenceCode.Code,referenceCode);
${spaces}      hasChanged = true;
${spaces}    }
${spaces}    if(hasChanged) {
${spaces}      m_codeArray = new IReferenceCode[m_codes.Count];
${spaces}      m_codes.Values.CopyTo(m_codeArray,0);
${spaces}    }
${spaces}  }
${spaces}
