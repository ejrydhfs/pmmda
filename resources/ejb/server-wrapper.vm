#set($serverName=${package.valueOfTag("ejb-server-name")})
#set($className="${serverName}Wrapper")
/** 
 * The ${serverName} wrapper wraps the J2EE session beans and hides the J2EE 
 * artifacts from the client application.
 * @version ${dollar}Revision${dollar}
 */
public class ${className} extends ComponentImpl implements DataObjectHandler {
  /** 
   * Name of the server as registered in the naming service.
   */
   public static final String SERVER_NAME = "${serverName}";

  /** 
   * Logger of the server wrapper class.
   */
  private static Log log = LogFactory.getLog(${className}.class);

  /** 
   * Handle to the EJB session bean providing the data object graph services.
   */
  private ${serverName}Session server;
  
  /** 
   * Creates the EJB session bean wrapper ${serverName} and registers it in 
   * the locator with the name ${serverName}.
   * @return the created and registered service wrapper.
   */
  public static ${className} create() {
    return create(SERVER_NAME);
  }
  
  /** 
   * Creates the EJB session bean wrapper ${serverName} and registers it in 
   * the locator with the name ${serverName}.
   * @param name name of the service wrapper as defined in the locator.
   * @return the created and registered service wrapper.
   */
  public static ${className} create(String name) {
    ${className} wrapper = null;
    try {
      Locator locator = Locator.getInstance();
      wrapper = new ${className}(name);
      locator.register(wrapper);
    } catch (ComponentException e) {
      log.fatal("Cannot register wrapper ${className}", e); 
    }
    return wrapper;
  }
  
  /** 
   * Constructor of the class.
   * @param name unique name of the server used to find through the locator.
   */
  public ${className}(String name) {
    super(name);
  }

  public void initialize() throws ComponentException {
    super.initialize();
    try {
      Context jndiContext = new InitialContext();
      Object ref = jndiContext.lookup("dog/${serverName}");
      ${serverName}Home home = (${serverName}Home)PortableRemoteObject.narrow(
        ref, ${serverName}Home.class);
      server = home.create();
    } catch (java.rmi.RemoteException e) {
      log.fatal(e);
    } catch (javax.naming.NamingException e) {
      log.fatal(e);
    } catch (javax.ejb.CreateException e) {
      log.fatal(e);
    }
  }  
   
  public void openDatasource(String datasource, boolean readonly) {
    assert datasource != null;
    // operation ignored because it is under control of the server.
  }
  
  public void closeDatasource(String datasource) {
    assert datasource != null;
    // operation ignored because it is under control of the server.
  }
  
