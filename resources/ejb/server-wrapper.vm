  public DataObject retrieve(String datasource, Class clazz, Integer id) {
    assert (datasource != null) && (clazz != null) && (id != null);
    List objects;
    DataObject object = null;
#if(!$isEmpty)
    try {
#set($firstCase=true)
#foreach($class in $classes)
#if(${class.booleanValueOfTag("bo-is-root")} && ${class.getStereotype().equalsIgnoreCase("dataObject")})
#set($boMoClass=${class.getAttribute("bo-mo-class")})
#if($firstCase)
#set($firstCase=false)
      if (clazz == ${boMoClass}.class) {
        objects = Arrays.asList(server.retrieve${boMoClass}(datasource, id, null));
#else
      } else if (clazz == ${boMoClass}.class) {
        objects = Arrays.asList(server.retrieve${boMoClass}(datasource, id, null));
#end
#end
#end
      } else {      
        throw new UnsupportedOperationException();
      }
      if (objects.size() > 0) {
        object = (DataObject)objects.get(0);
      }
    } catch(ServerException e) {
      log.error(e);
    } catch(RemoteException e) {
      log.error(e);
    }
#end
    return object;
  }
  
