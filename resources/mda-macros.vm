## emit file header for a Java source file artifact.
#macro(emitFileHeader)
#set($_dollar="$")
/* This code was generated automatically with the pmMDA generator. Please do 
   NOT add code outside the marked zones. All changes outside the marked areas 
   will be discarded during the next execution of the MDA generator. 
   ${_dollar}Id${_dollar}
*/
#end

## emit the description for a meta class for a Java source file artifact.
## @param $element element which description should be generated.
## @param $spaces leading spaces for the indentation of the comment.
#macro(emitClassDescription $element $spaces)
#set($_dollar="$")
#set($_offset=${spaces.length()} + 3)
#set($_lines = ${element.docComment(${_offset})})
#if(${_lines.size()} > 0)
${spaces}/**
#foreach($_line in $_lines)
${spaces} * ${_line}
#end
${spaces} * @version ${_dollar}Revision${_dollar}
${spaces} * @author ${element.valueOfTag("author")}
${spaces} */
#end
#end

## emit the description for a meta property for a Java source file artifact.
## @param $element element which description should be generated.
## @param $spaces leading spaces for the indentation of the comment.
#macro(emitPropertyDescription $element $spaces)
#set($_offset=${spaces.length()} + 3)
#set($_lines = ${element.docComment(${_offset})})
#if(${_lines.size()} > 0)
${spaces}/**
#foreach($_line in $_lines)
${spaces} * ${_line}
#end
${spaces} */
#end
#end

## Returns true if the element is a data object.
## @param $element element to check if it has the "data object" stereotype.
## @return true if the stereotype is defined otherwise false.
#macro(isDataObject $element $result)
#set($_DATA_OBJECT="dataObject")
#set($result=${_DATA_OBJECT.equalsIgnoreCase(${element.getStereotype()})})
#end

## Returns true if the element is a data object.
## @param $element element to check if it has the "reference code" stereotype.
## @return true if the steretotype is defined otherwise false.
#macro(isReferenceCode $element $result)
#set($_REFERENCE_CODE="referenceCode")
#set($result=${_REFERENCE_CODE.equalsIgnoreCase(${element.getStereotype()})})
#end

## Returns true if the element is a data object.
## @param $element element to check if it is a lightweight object.
## @return true if the element is a lightweight object otherwise false.
#macro(isLightweightDataObject $element $result)
#set($_DATA_OBJECT="dataObject")
#set($result=${_DATA_OBJECT.equalsIgnoreCase(${element.getStereotype()})} && ${element.booleanValueOfAttribute("bo-lightweight")})
#end

## Returns true if the class has a direct ancestor being a data object.
#macro(hasDataObjectAncestor $element $result)
#set($_ancestors=${class.retrieveAncestors()})
#set($result = (${_ancestors.size()} > 0))
#if($result)
#isDataObject($element $result)
#end
#end

## Returns the type object of the type name defined in the element.
#macro(getType $model $element $result)
#set($_typename=${element.getTypeName()})
#set($result=false)
#set($result=${model.findClass(${_typename})})
#end

## Returns true if the type object of the type name defined in the element is a data object.
#macro(isTypeModel $model $element $result)
#getType($model $element $_type)
#set($result=$_type && ${_DATA_OBJECT.equalsIgnoreCase(${_type.getStereotype()})})
#end

## Returns true if the type object of the type name defined in the element is a lightweight 
## data object.
#macro(isTypeLightweigth $model $element $result)
#set($_DATA_OBJECT="dataObject")
#getType($model $element $_type)
#set($result=$_type && ${_DATA_OBJECT.equalsIgnoreCase(${_type.getStereotype()})} && (${_type.getAttribute("bo-lightweight")}))
#end

## Returns true if the type exists and is a persistent data object
#macro(isPersistentDataObject $type $result)
#set($_DATA_OBJECT="dataObject")
#set($result=${type} && ${_DATA_OBJECT.equalsIgnoreCase(${type.getStereotype()})} && ${type.booleanValueOfTag("persistence")})
#end

#macro(isTypePersistent $model $element $result)
#set($_type=false)
#getType($model $element $_type)
#isPersistentDataObject($_type $result)
#end

