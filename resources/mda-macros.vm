#macro(getReverseFk $reference $property $result)
#set($_refTable=${reference.valueOfTag("orm-table-name")})
#set($result="${_refTable}_${property.nameUpper()}_FK")
#end

#macro(getForwardHdl $property $result)
#set($result="${property.nameFirstLower()}Handle")	
#end

#macro(getReverseHdl $reference $property $result)
