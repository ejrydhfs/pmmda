  /** Stores the data object graph with the given root identifier.
   * @param datasource datasource containing the persistent objects.
   * @param id identifier of the root object.
   * @throws DogException the remote server encountered an error.
   */
  private List store${boMoClass}(String datasource, ${boMoClass} root)
	throws DogException {
    assert((datasource != null) && (root != null));
	try {
      ${ctoMoClass} cto = ${boMoClass}Transformer.transform(root);
      DataObjectUpdateCto[] ctos = server.store${boMoClass}(datasource, cto);
      List infos = TransformerCto.extractInfos(ctos);
      return infos;    
	} catch (DogExceptionCto e) {
	  throw TransformerCto.extract(e);
	}
  }
  
