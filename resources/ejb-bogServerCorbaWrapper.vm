  /** Retrieves the data object graph with the given root identifier or
   * constraints.
   * @param datasource datasource containing the persistent objects.
   * @param id identifier of the root object.
   * @param constraints constraints to select the set of requested graphs.
   * @throws DogException the remote server encountered an error.
   */  
  private List retrieve${boMoClass}(String datasource, Integer id, String constraints) 
    throws DogException {
    try {
      int idValue = (id == null) ? ILLEGAL_ID : id.intValue();
      String constraintsValue = (constraints == null) ? "" : constraints;
      ${ctoMoClass}[] ctos = server.retrieve${boMoClass}(datasource, idValue, 
        constraintsValue);
	  List bos = ${boMoClass}Transformer.transform(ctos);
	  return bos;
	} catch (DogExceptionCto e) {
	  throw TransformerCto.extract(e);
	}
  }
