<table name="${schema}${table}"
	   javaName="${package.getAttribute("bo-mo-package")}.${class.getAttribute("bo-mo-class")}"
	   idMethod="none">
## ==============================================================
##  Add common fields (ID, TS)
## ==============================================================
#if(${DATA_OBJECT.equalsIgnoreCase(${class.getStereotype()})})
  <column name="ID"
          primaryKey="true"
          required="true"
          type="INTEGER"/>
  <column name="TS"
          primaryKey="false"
          required="true"
          type="TIMESTAMP" />
#end
