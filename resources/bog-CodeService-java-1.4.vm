  protected List getActiveCodes(int codeType) {
    Iterator it = codes[codeType].values().iterator();
    List list = new ArrayList();
    while (it.hasNext()) {
      ReferenceCode code = (ReferenceCode)it.next();
      if (code.getActive()) {
