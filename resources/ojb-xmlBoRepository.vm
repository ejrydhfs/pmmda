#if(${class.getStereotype().equalsIgnoreCase("dataObject")})
#set($shouldGenerateFkIndex=${configuration.getProperty("ojb-cartridge.generate-fk-index").equalsIgnoreCase("true")})
#set($inheritanceMode=${configuration.getProperty("ojb-cartridge.inheritance")})
#set($schema=${package.valueOfTag("ojb-schema")})
#if(${schema})#set($schema="${schema}.")#else#set($schema="")#end
#set($table=${class.getAttribute("ojb-table-name")})
<class-descriptor class="${package.getAttribute("bo-mo-package")}.${class.getAttribute("bo-mo-class")}"
  table="${schema}${table}">
  <field-descriptor name="id" 
    column="ID" 
    jdbc-type="INTEGER" 
  	primarykey="true"
    nullable="false"
    indexed="true"
  	autoincrement="true"/>
  <field-descriptor name="timestamp"
    column="TS"
    jdbc-type="TIMESTAMP"
    nullable="false"
    locking="true"/>
## generates all primitive properties as a column. A primitive property is 
## either a simple property or an indexed property with a cardinality of 1
## having as type a class not being a data object.
#foreach($property in $properties)
#if(!${property.isTransient()})
#set($columnType=${property.valueOfTag("ojb-column-type").toUpperCase()})
#set($columnName=${property.getAttribute("ojb-column-name").toUpperCase()})
#getType($model $property $type)	
#isPersistentDataObject($type $isPersistentDataObject)
#if($isPersistentDataObject)
  <field-descriptor name="${property.nameFirstLower()}Handle"
    column="${property.nameUpper()}_FK"
    jdbc-type="INTEGER"
    nullable="${property.booleanValueOfTag("ojb-can-be-null")}"/>
#else
  <field-descriptor name="${property.nameFirstLower()}"
    column="${columnName}"
#if(${columnType.equalsIgnoreCase("STRING")})
    jdbc-type="VARCHAR"
#else    
#if (${columnType.equalsIgnoreCase("BOOLEAN")})
    jdbc-type="INTEGER"
    conversion="org.apache.ojb.broker.accesslayer.conversions.Boolean2IntFieldConversion"
#else
    jdbc-type="${columnType}"
#end
#end
#if(${property.booleanValueOfTag("ojb-is-primary")})
    primarykey="true"
#end
    nullable="${property.booleanValueOfTag("ojb-can-be-null")}"/>
#end
#end
#end
## references of persistent classes having indexed properties with cardinality 1-N 
## to the processed class are generated as reverse foreign keys in the class.
#set($references=$model.getClassReferences($class))
#foreach($reference in $references)
#isPersistentDataObject($reference $isPersistentDataObject)
#if($isPersistentDataObject)
#set($relations=${reference.getIndexedProperties()})
#foreach($relation in $relations)
#getType($model $relation $type)	
#if(${type} == ${class})
  <field-descriptor 
    name="${reference.nameFirstLower()}${relation.nameFirstUpper()}Handle" 
    column="${reference.valueOfTag("ojb-table-name")}_${reference.nameUpper()}_FK"
    jdbc-type="INTEGER"
    nullable="${relation.canBeNull()}"/>
#end
#end
#end
#end
#foreach($aggregation in $aggregations)
#if(${aggregation.getMultiplicity().getUpperBound()} == 1)
#set($columnName=${aggregation.getAttribute("ojb-column-name")})
#getType($model $aggregation $type)	
#isPersistentDataObject($type $isPersistentDataObject)
#if($isPersistentDataObject)
  <field-descriptor name="${aggregation.nameFirstLower()}Handle"
#if($isDataObject)
    column="${aggregation.nameUpper()}_FK"
    jdbc-type="INTEGER"
    access="anonymous"
    nullable="${aggregation.booleanValueOfTag("ojb-can-be-null")}"/>
#else
    column="${aggregation.getAttribute("ojb-column-name")}"
    jdbc-type="${aggregation.valueOfTag("ojb-column-type")}"
    nullable="${aggregation.booleanValueOfTag("ojb-can-be-null")}"
#if(${aggregation.getTaggedValue("ojb-is-primary")} == "true")
    primaryKey="true"
    autoincrement="true"/>
#end
#end    
#end
#end
#end
## generates all forward references as a foreign key column. A forward 
## reference is either a simple property or an indexed property with a 
## cardinality of 1 having as type a class being a data object.
#foreach($property in $properties)
#getType($model $property $type)	
#isDataObject($type $isDataObject)
#if($isDataObject)
  <reference-descriptor
    name="${property.getName()}"
    class-ref="${type.qualifiedName()}">
    <foreignkey field-ref="${property.getName()}Handle"/>
  </reference-descriptor>
#end
#end
#foreach($aggregation in $aggregations)
#if(${aggregation.getMultiplicity().getUpperBound()} == 1)
#set($columnName=${aggregation.getAttribute("ojb-column-name")})
#getType($model $aggregation $type)	
#isPersistentDataObject($type $isPersistentDataObject)
#if($isPersistentDataObject)
  <reference-descriptor
    name="${aggregation.getName()}"
    class-ref="${type.qualifiedName()}">
    <foreignkey field-ref="${aggregation.nameFirstLower()}Handle"/>
  </reference-descriptor>
#end
#end
#end
## generates all backward references as a foreign key column declared in the
## owned class. A backward reference is an indexed property with a cardinality
## of n having as type a class being a data object. 
#foreach($aggregation in $aggregations)
#if(${aggregation.getMultiplicity().getUpperBound()} == -1)
#getType($model $aggregation $type)	
#isPersistentDataObject($type $isPersistentDataObject)
#if($isPersistentDataObject)
#set($typePackage=${type.getContext()})
  <collection-descriptor
    name="${aggregation.getName()}"
    collection-class="org.apache.ojb.broker.util.collections.ManageableArrayList"
    element-class-ref="${typePackage.getAttribute("bo-mo-package")}.${type.getAttribute("bo-mo-class")}"
    orderby="id"
    sort="ASC">
    <inverse-foreignkey field-ref="${class.nameFirstLower()}${aggregation.nameFirstUpper()}Handle"/>
  </collection-descriptor>
#end
#end
#end
  <index-descriptor 
    name="${table}_IDX" 
    unique="true">
    <index-column name="id"/>
  </index-descriptor>
#if($shouldGenerateFkIndex)
#foreach($property in $properties)
#if(!${property.isTransient()})
#getType($model $property $type)
#isPersistentDataObject($type $isPersistentDataObject)
#if($isPersistentDataObject)
#set($name=${property.nameUpper()})
  <index-descriptor 
	name="${table}_${name}_IDX" 
	unique="false">
	<index-column name="${name}_FK"/>
  </index-descriptor>
#end
#end
#end
#foreach($aggregation in $aggregations)
#if(!${aggregation.isTransient()} && (${aggregation.getMultiplicity().getUpperBound()} == 1))
#set($typeName=${aggregation.getTypeName()})
#set($type=false)
#set($type=${model.findClass(${typeName})})
#isPersistentDataObject($type $isPersistentDataObject)
#if($isPersistentDataObject)
#set($name=${aggregation.nameUpper()})
  <index-descriptor 
	name="${table}_${name}_IDX" 
	unique="false">
	<index-column name="${name}_FK"/>
  </index-descriptor>
#end
#end
#end
#set($references=$model.getClassReferences($class))
#foreach($reference in $references)
#isPersistentDataObject($type $isPersistentDataObject)
#if($isPersistentDataObject)
#set($relations=${reference.getIndexedProperties()})
#foreach($relation in $relations)
#getType($model $relation $type)	
#if(${type} == ${class})
#set($refTable=${reference.valueOfTag("ojb-table-name")})
#set($relationName=${relation.nameUpper()})
  <index-descriptor 
	name="${table}_${refTable}_${relationName}_IDX" 
	unique="false">
	<index-column name="${refTable}_${relationName}_FK"/>
  </index-descriptor>
#end
#end
#end
#end
#end
#set($subClasses=${model.findSubClasses($class)})
#foreach($subClass in $subClasses)
#if(${subClass.getStereotype().equalsIgnoreCase("dataObject")})
  <extent-class class-ref="${subClass.qualifiedName()}"/>
