## Test whether a property can be read
## @param $element MetaElement of which the readable flag is emmited
## @param $isReadable Contains the readable flag
###macro(isReadable $metaElement $isReadable)
###set($isReadable="false")
###set($mode=${metaElement.getTaggedValue("bo-mode")})
###if(${mode.equals("READ")} || ${mode.equals("READ_WRITE")})
###set($isReadable="true")
###end
###end
## Test whether a property can be written
## @param $element MetaElement of which the writable flag is emmited
## @param $isReadable Contains the wrttable flag
###macro(isWritable $metaElement $isWritable)
###set($isWritable="false")
###set($mode=${metaElement.getTaggedValue("bo-mode")})
###if(${mode.equals("WRITE")} || ${mode.equals("READ_WRITE")})
###set($isWritable="true")
###end
###end
## Emits the xml documentation of a meta element
## @param $element MetaElement which description should be emitted
## @param $netHelper A helper class for .net.
## @param $spaces leading spaces for the indentation of the comment.
#macro(emitXMLDocu $metaElement $netHelper $spaces)
#set($lines = ${netHelper.getXmlDocLines(${metaElement})})
#if(${lines.size()} > 0)
${spaces}/// <summary>
#foreach($line in $lines)
${spaces}/// ${line}
#end
${spaces}/// </summary>
#end
#end
## Emits the xml documentation of a meta property
## @param $element MetaElement which description should be emitted
## @param $spaces leading spaces for the indentation of the comment.
#macro(emitXMLDocuForProperty $metaProperty $netHelper $spaces)
#if(${metaProperty.canBeRead()} && ${metaProperty.canBeWritten()})
${spaces}/// <summary>
${spaces}/// Gets or sets the value of the ${metaProperty.getName()} property.
${spaces}/// </summary>
#else
#if(${metaProperty.canBeWritten()})
${spaces}/// <summary>
${spaces}/// Sets the value of the ${metaProperty.getName()} property.
${spaces}/// </summary>
#end
#if(${metaProperty.canBeRead()})
${spaces}/// <summary>
${spaces}/// Gets the value of the ${metaProperty.getName()} property.
${spaces}/// </summary>
#end
#end
#set($lines = ${netHelper.getXmlDocLines(${metaProperty})})
#if(${lines.size()} > 0)
${spaces}/// <remarks>
#foreach($line in $lines)
${spaces}/// ${line}
#end
${spaces}/// </remarks>
#end
#end
## Returns true if the element is a lightweight object.
#macro(isLightweightObject $element $result)
#set($DATA_OBJECT="DataObject")
#set($result=${DATA_OBJECT.equalsIgnoreCase(${element.getStereotype()})} && ${element.booleanValueOfAttribute(".net-lightweight")})
#end
