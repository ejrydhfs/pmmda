/** 
 * Transformer helper class responsible for the transformation of data objects
 * between their data object and data transfer object representation.
 * @version ${dollar}Revision${dollar}
 */
public final class ${classname} {
  /** 
   * Transforms a data object into a data transfer object. The children are
   * recursively transformed.
   * @param bo data object to transform.
   * @return the data transfer object representation.
   * @see ${sign}transform(${dtoName})
   */
  public static final ${dtoName} transform(${dogName} bo) {
    ${dtoName} dto = new ${dtoName}();
#foreach($property in $properties) 
#if(!${property.isTransient()})
#set($typeName=${property.getTypeName()})
#set($type=false)
#set($type=${model.findClass(${typeName})})
#if(${type} && ${type.getStereotype()} == "dataObject")
#getForwardHdl($property $handle)
    if (bo.get${property.nameFirstUpper()}() != null) {
	  dto.${property.getName()} = new ${type.getAttribute("cto-mo-class")}[1];
      dto.${property.getName()}[0] = ${type.getAttribute("bo-mo-class")}Transformer.transform(bo.get${property.nameFirstUpper()}());
	  dto.${handle} = TransformerCto.getHandle(bo, "${handle}");
    } else {
      dto.${property.getName()} = new ${type.getAttribute("cto-mo-class")}[0];
	  dto.${handle} = TransformerCto.nullInteger;
    }
#else
    dto.${property.getName()} = ${cartridge.getBo2DtoConversion(${property}, "bo")};
#end
#end
#end
#foreach($aggregation in $aggregations)
#if(!${aggregation.isTransient()})
#set($aggregationName=${aggregation.getName()})
#set($typeName=${aggregation.getTypeName()})
#set($type=false)
#set($type=${model.findClass(${typeName})})
#if(${type} && ${type.getStereotype()} == "dataObject")
    dto.${aggregation.getName()} = ${type.getAttribute("bo-mo-class")}Transformer.transform(bo.get${aggregation.nameFirstUpper()}());
#else
    dto.${aggregation.getName()} = ${cartridge.getBo2DtoConversion(${aggregation}, "bo")};
#end
#end
#end
#set($references=$model.getClassReferences($class))
#foreach($reference in $references)
#isPersistentDataObject($reference $isPersistentDataObject)
#if($isPersistentDataObject)
#set($relations=${reference.getIndexedProperties()})
#foreach($relation in $relations)
#getType($model $relation $type)
#if(${type} == ${class})
#getReverseHdl($reference $relation $handle)
    dto.${handle} = TransformerCto.getHandle(bo, "${handle}");
#end
#end
#end
#end
	dto.id = TransformerCto.create(bo.getId());
    dto.timestamp = TransformerCto.create(bo.getTimestamp());
    dto.modified = bo.isModified();
    return dto;
  }

  /** 
   * Transforms a data transfer object into a data object. The children are
   * recursively transformed. The Java bean conventions are used to set the
   * attributes.
   * @param dto data transfer object to transform.
   * @return the data object representation.
   * @see ${sign}transform(${dogName})
   */  
  public static final ${dogName} transform(${dtoName} dto) {
    ${dogName} bo = new ${dogName}();
    bo.setId(TransformerCto.extract(dto.id));
    bo.setTimestamp(TransformerCto.extract(dto.timestamp));
#foreach($property in $properties) 
#if(!${property.isTransient()})
#set($typeName=${property.getTypeName()})
#set($type=false)
#set($type=${model.findClass(${typeName})})
#if(${type} && ${type.getStereotype()} == "dataObject")
#getForwardHdl($property $handle)
    if (dto.${property.nameFirstLower()}.length == 1) {
      bo.set${property.nameFirstUpper()}(${type.getAttribute("bo-mo-class")}Transformer.transform(dto.${property.nameFirstLower()}[0]));
    }
	TransformerCto.setHandle(bo, "${handle}", dto.${handle});
#else
#setterName($property $setter)
    bo.${setter}(${cartridge.getDto2BoConversion(${property}, "dto")});
#end
#end
#end
#foreach($aggregation in $aggregations)
#set($typeName=${aggregation.getTypeName()})
#set($type=false)
#set($type=${model.findClass(${typeName})})
#if(${type} && ${type.getStereotype()} == "dataObject")
    bo.add${aggregation.nameFirstUpper()}(${type.getAttribute("bo-mo-class")}Transformer.transform(dto.${aggregation.nameFirstLower()}));
#end
#end
#set($references=$model.getClassReferences($class))
#foreach($reference in $references)
#isPersistentDataObject($reference $isPersistentDataObject)
#if($isPersistentDataObject)
#set($relations=${reference.getIndexedProperties()})
#foreach($relation in $relations)
#getType($model $relation $type)
#if(${type} == ${class})
#getReverseHdl($reference $relation $handle)
    TransformerCto.setHandle(bo, "${handle}", dto.${handle});
#end
#end
#end
#end
    bo.setModified(dto.modified);
    return bo;
  }

  /** 
   * Transforms an list of data objects into a list of corresponding data
   * transfer objects.
   * @param bos list of data objects.
   * @return the array of converted data transfer objects.
   */
  public static final ${dtoName}[] transform(List bos) {
    int size = bos.size();
    ${dtoName}[] dtos = new ${dtoName}[size];
    for (int i = 0; i < size; i++) {
      dtos[i] = transform((${dogName})bos.get(i));
    }
    return dtos;
  }

  /** 
   * Transforms an array of data transfer objects into a list of corresponding
   * data objects.
   * @param dtos array of data transfer objects.
   * @return the list of converted data objects.
   */
  public static final List transform(${dtoName}[] dtos) {
    ArrayList bos = new ArrayList();
    for (int i = 0; i < dtos.length; i++) {
      bos.add(transform(dtos[i]));
    }
    return bos;
  }  
  
  /**
   * Private default constructor to realize a static class.
   */
  private ${classname}() {
  }
}
