  /** 
   * Implements the visitor pattern in the data object class. The accept
   * method dispatches the visitor to all its relevant children. A relevant
   * child is always another data object.
   * @param visitor visitor to act on the data object.
   */  
  public void accept(Visitor visitor) {
    visitor.setDepth(visitor.getDepth() + 1);
    visitor.visit(this);
#foreach ($property in $properties)
#isTypeModel($model $property $isTypeModel)
#if($isTypeModel)
    if (${property.nameFirstLower()} != null) {
      ${property.nameFirstLower()}.accept(visitor);
    }
#end
#end
#foreach ($aggregation in $aggregations) 
#isTypeModel($model $aggregation $isTypeModel)
#if($isTypeModel)
    for (Iterator i = ${aggregation.nameFirstLower()}.iterator(); i.hasNext();) {
      ((${type.getAttribute("bo-mo-class")})i.next()).accept(visitor);
    }
#end
#end
    visitor.setDepth(visitor.getDepth() - 1);
  }
  
  /** 
   * Creates and returns a deep copy of the object and its descendants. The 
   * properties containing keys are not cloned because they are immutable.
   * @return a deep copy of the instance.
   */
  public DataObject copy() {
    ${class.getAttribute("bo-mo-class")} clone = null;
    try {
      clone = (${class.getAttribute("bo-mo-class")})clone();
    } catch (CloneNotSupportedException e) {
      // impossible exception because data object is cloneable.
      return null;
    }
#foreach ($property in $properties)
#isTypeModel($model $property $isTypeModel)
#if($isTypeModel)
#set($lName=${property.nameFirstLower()})
    if (${lName} != null) {
      clone.${lName} = (${property.retrieveTypeClassName()})${lName}.copy();
    }
#end 
#end
#foreach ($aggregation in $aggregations) 
#set($lName = ${aggregation.nameFirstLower()})
    clone.${lName} = new ${aggregation.valueOfTag("bo-container-class")}();
    for (int i = 0; i < ${lName}.size(); i++) {
      clone.${lName}.add(((DataObject)${lName}.get(i)).copy());
    }
#end
    clone.setModified(isModified());
    return clone;
  }

