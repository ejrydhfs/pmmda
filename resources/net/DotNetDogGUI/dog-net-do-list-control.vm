    private void vScrollBar_Scroll(object sender, System.Windows.Forms.ScrollEventArgs e)
    {
      if (m_collectionIdentifier != null) 
      {
        int delta = e.NewValue - vScrollBar.Value;
        m_currentVScrollValue = e.NewValue;
        if (delta != 0) 
        {
          ScrollItems(delta);
        }
      }
    }
    
    private void vScrollBar_ValueChanged(object sender, System.EventArgs e)
    {
      if (m_collectionIdentifier != null) 
      {
        int delta = vScrollBar.Value - m_currentVScrollValue;
        m_currentVScrollValue = vScrollBar.Value;
        if (delta != 0) 
        {
          ScrollItems(delta);
        }
      }
    }
