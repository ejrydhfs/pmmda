#end
      vScrollBar.Maximum = 1;
      vScrollBar.LargeChange = 1;
      vScrollBar.Value = vScrollBar.Minimum;
      m_currentVScrollValue = vScrollBar.Minimum;
    }
    
    private void UpdateItems() 
    {
#foreach($primitiveProperty in $primitiveProperties)
#set($propertyNameUpper=${primitiveProperty.nameFirstUpper()})
      list${propertyNameUpper}.SelectedIndexChanged -= new EventHandler(this.list${propertyNameUpper}_SelectedIndexChanged);
#end
      int visibleItemCount = VisibleItemCount;
      for (int i = visibleItemCount; i < ListItemCount; /* NO i++ !! */) 
      {
#foreach($primitiveProperty in $primitiveProperties)
#set($propertyNameUpper=${primitiveProperty.nameFirstUpper()})
        list${propertyNameUpper}.Items.RemoveAt(i);
#end
      }

      if (m_collectionIdentifier != null) 
      {
        for (int i = m_collectionIdentifier.Count; i < ListItemCount;) 
        {
#foreach($primitiveProperty in ${primitiveProperties})
#set($propertyNameUpper=${primitiveProperty.nameFirstUpper()})
          list${propertyNameUpper}.Items.RemoveAt(i);
#end
        }
        if (m_collectionIdentifier.CollectionType == CollectionType.Set) 
        {
          if (m_currentItem != null) 
          {
            ${doQualifiedClassName} current = m_currentItem;
            for (int i = 0; i < visibleItemCount; i++) 
            {
              if (current == null) 
              {
                break;
              }
              SetAt(i, current);
              current = (${doQualifiedClassName}) m_collectionIdentifier.GetNext(current);
            }
          }
        }
        else 
        {
          for (int i = 0; i < visibleItemCount; i++) 
          {
            int index = m_currentIndex + i;
            if (index >= m_collectionIdentifier.Count) 
            {
              break;
            }
            ${doQualifiedClassName} item = (${doQualifiedClassName}) m_collectionIdentifier.List[index];
            SetAt(i, item);
          }
        }
        if (vScrollBar.Maximum != m_collectionIdentifier.Count - 1) 
        {
          if (m_collectionIdentifier.Count > 0) 
          {
            vScrollBar.Maximum = m_collectionIdentifier.Count - 1;
          }
          else 
          {
            vScrollBar.Maximum = 0;
          }
        }
        if (vScrollBar.LargeChange != VisibleItemCount) 
        {
          vScrollBar.LargeChange = VisibleItemCount;
        }
      }
#foreach($primitiveProperty in $primitiveProperties)
#set($propertyNameUpper=${primitiveProperty.nameFirstUpper()})
      list${propertyNameUpper}.SelectedIndexChanged += new EventHandler(this.list${propertyNameUpper}_SelectedIndexChanged);
#end
      if (m_selectedGUIIndex > -1 && m_selectedGUIIndex < ListItemCount) 
      {
        SetSelectedIndex(m_selectedGUIIndex, false);
      }
    }

    private void SetAt(int guiIndex, ${doQualifiedClassName} item) 
    {
      if (guiIndex < ListItemCount) 
      {
#foreach($primitiveProperty in $primitiveProperties)
#set($propertyNameUpper=${primitiveProperty.nameFirstUpper()})
#set($propertyType=${netHelper.convertJavaTypeToDotnet(${primitiveProperty.getTypeName()})})
#getType($model $primitiveProperty $primitivePropertyType)
#isReferenceCode($primitivePropertyType $propertyIsReferenceCode)
#if(${propertyType.equals("string")})

		// ${propertyNameUpper}
        if (item.${propertyNameUpper} != null) 
        {
          list${propertyNameUpper}.Items[guiIndex] = item.${propertyNameUpper};
        }
        else 
        {
          list${propertyNameUpper}.Items[guiIndex] = string.Empty;
        }
#elseif($propertyIsReferenceCode)

		// ${propertyNameUpper}
        if (item.${propertyNameUpper} != null) 
        {
		  list${propertyNameUpper}.Items[guiIndex] = item.${propertyNameUpper}.ToString();
        }
        else 
        {
          list${propertyNameUpper}.Items[guiIndex] = string.Empty;
        }
#else
        list${propertyNameUpper}.Items[guiIndex] = item.${propertyNameUpper}.ToString();
#end
#end      
      }
      else if (guiIndex == ListItemCount) 
      {
#foreach($primitiveProperty in $primitiveProperties)
#set($propertyNameUpper=${primitiveProperty.nameFirstUpper()})
#set($propertyType=${netHelper.convertJavaTypeToDotnet(${primitiveProperty.getTypeName()})})
#getType($model $primitiveProperty $primitivePropertyType)
#isReferenceCode($primitivePropertyType $propertyIsReferenceCode)
#if(${propertyType.equals("string")})

		// ${propertyNameUpper}
        if (item.${propertyNameUpper} != null) 
        {
          list${propertyNameUpper}.Items.Add(item.${propertyNameUpper});
        }
        else 
        {
          list${propertyNameUpper}.Items.Add(string.Empty);
        }
#elseif($propertyIsReferenceCode)

		// ${propertyNameUpper}
		if (item.${propertyNameUpper} != null) 
        {
		  list${propertyNameUpper}.Items.Add(item.${propertyNameUpper}.ToString());
        }
        else 
        {
          list${propertyNameUpper}.Items.Add(string.Empty);
        }
#else
        list${propertyNameUpper}.Items.Add(item.${propertyNameUpper}.ToString());
#end
#end 
      }
      else 
      {
        throw new ArgumentOutOfRangeException("The index is to big.");
      }
    }

    private int VisibleItemCount 
    {
      get 
      {
#if($primitivePropertiesCount>0)
#set($propertyNameUpper=${primitiveProperties.get(0).nameFirstUpper()})
        int listHeight = panelHScroll.ClientSize.Height - panelButtons.Height - splitterBottom.Height - splitter${propertyNameUpper}Filter.Height - txt${propertyNameUpper}Filter.Height - label${propertyNameUpper}.Height - splitterTop.Height;
        int visibleItemCount = (listHeight - 1) / list${propertyNameUpper}.ItemHeight;
        if (visibleItemCount < 0) 
        {
          visibleItemCount = 0;
        }
        return visibleItemCount;
#else
        return 0;
#end
      }
    }
    
    private int ListItemCount
    {
      get
      {
#if($primitivePropertiesCount>0)
#set($propertyNameUpper=${primitiveProperties.get(0).nameFirstUpper()})
        return list${propertyNameUpper}.Items.Count;
#else
        return 0;
#end        
      }
    }
    
    private void ResetOrder() 
    {
      if (m_collectionIdentifier != null)
      {
        m_collectionIdentifier.Order.Clear();
#foreach($primitiveProperty in $primitiveProperties)
#set($propertyNameUpper=${primitiveProperty.nameFirstUpper()})
#set($propertyFieldName="m_${primitiveProperty.nameFirstLower()}")
        if (label${propertyNameUpper}.BackColor == SystemColors.Highlight)
        {
          m_collectionIdentifier.Order.Add(new OrderParameter(${quotes}${propertyFieldName}${quotes}, OrderDirection.Ascending));
        }
#end
      }
      vScrollBar.Value = vScrollBar.Minimum;
      UpdateItems();
    }
    
    private void ScrollItems(int delta) 
    {
      if (m_collectionIdentifier.CollectionType == CollectionType.Set) 
      {
        bool ahead = delta >= 0;
        if (delta < 0) 
        {
          delta = -1 * delta;
        }
        for (int i = 0; i < delta; i++) 
        {
          if (ahead) 
          {
            m_currentItem = (${doQualifiedClassName}) m_collectionIdentifier.GetNext(m_currentItem);
          }
          else 
          {
            m_currentItem = (${doQualifiedClassName}) m_collectionIdentifier.GetPrevious(m_currentItem);
          }
        }
        UpdateItems();
      }
      else 
      {
        m_currentIndex += delta;
        UpdateItems();
      }

      if (m_selectedItem != null) 
      {
        m_selectedGUIIndex -= delta;
        if (m_selectedGUIIndex > -1 && m_selectedGUIIndex < ListItemCount) 
        {
          SetSelectedIndex(m_selectedGUIIndex, false);
        }
        else 
        {
          SetSelectedIndex(-1, false);
        }
      }
    }
    
    private void ResetSelection() 
    {
#foreach($primitiveProperty in $primitiveProperties)
#set($propertyNameUpper=${primitiveProperty.nameFirstUpper()})
      list${propertyNameUpper}.SelectedIndexChanged -= new EventHandler(this.list${propertyNameUpper}_SelectedIndexChanged);
#end
      m_selectedGUIIndex = -1 - this.vScrollBar.Value;
#foreach($primitiveProperty in $primitiveProperties)
#set($propertyNameUpper=${primitiveProperty.nameFirstUpper()})
      list${propertyNameUpper}.SelectedIndex = -1;
#end
      m_selectedItem = null;
      btnEdit.Enabled = false;
      btnRemove.Enabled = false;
      btnMoveUp.Enabled  = false;
      btnMoveDown.Enabled  = false;
#foreach($primitiveProperty in $primitiveProperties)
#set($propertyNameUpper=${primitiveProperty.nameFirstUpper()})
      list${propertyNameUpper}.SelectedIndexChanged += new EventHandler(this.list${propertyNameUpper}_SelectedIndexChanged);
#end
    }

    private void SetSelectedIndex(int guiIndex, bool adjustSelectedGUIIndex) 
    {
#foreach($primitiveProperty in $primitiveProperties)
#set($propertyNameUpper=${primitiveProperty.nameFirstUpper()})
      list${propertyNameUpper}.SelectedIndexChanged -= new EventHandler(this.list${propertyNameUpper}_SelectedIndexChanged);
#end
#foreach($primitiveProperty in $primitiveProperties)
#set($propertyNameUpper=${primitiveProperty.nameFirstUpper()})
      list${propertyNameUpper}.SelectedIndex = guiIndex;
#end
      if (m_collectionIdentifier != null && adjustSelectedGUIIndex) 
      {
        m_selectedGUIIndex = guiIndex;
        if (guiIndex > -1) 
        {
          if (m_collectionIdentifier.CollectionType == CollectionType.Set) 
          {
            m_selectedItem = m_currentItem;
            for (int i = 0; i < guiIndex; i++) 
            {
              m_selectedItem = (${doQualifiedClassName}) m_collectionIdentifier.GetNext(m_selectedItem);
            }
          }
          else 
          {
            m_selectedItem = (${doQualifiedClassName}) m_collectionIdentifier.List[m_currentIndex + guiIndex];
          }
        }
        else 
        {
          m_selectedItem = null;
        }
      }

      bool itemSelected = m_selectedItem != null && !m_collectionIdentifier.ReadOnly;
      btnEdit.Enabled = itemSelected;
      btnRemove.Enabled = itemSelected;
      btnMoveUp.Enabled  = itemSelected;
      btnMoveDown.Enabled  = itemSelected;

#foreach($primitiveProperty in $primitiveProperties)
#set($propertyNameUpper=${primitiveProperty.nameFirstUpper()})
      list${propertyNameUpper}.SelectedIndexChanged += new EventHandler(this.list${propertyNameUpper}_SelectedIndexChanged);
#end
    }

