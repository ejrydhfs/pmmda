    private void list${propertyNameUpper}_SelectedIndexChanged(object sender, System.EventArgs e)
    {
      SetSelectedIndex(list${propertyNameUpper}.SelectedIndex, true);
    }
    
    private void label${propertyNameUpper}_Click(object sender, System.EventArgs e)
    {
      bool order = label${propertyNameUpper}.BackColor == SystemColors.Highlight;
      ResetTitleColors();
      if (!order) 
      {
        label${propertyNameUpper}.BackColor = SystemColors.Highlight;
        label${propertyNameUpper}.ForeColor = SystemColors.HighlightText;
      }
      ResetOrder();
    }
#end
    
    private void btnAdd_Click(object sender, System.EventArgs e)
    {
      if (m_collectionIdentifier != null) 
      {
        ${doQualifiedClassName} item = new ${doQualifiedClassName}();
        ${doClassName}Dialog dialog = new ${doClassName}Dialog();
        dialog.${doClassName} = item;
        dialog.ShowDialog(this);
        m_collectionIdentifier.Add(item);
        UpdateItems();
      }
    }

    private void btnRemove_Click(object sender, System.EventArgs e)
    {
      if (m_collectionIdentifier != null) 
      {
        ${doQualifiedClassName} item = SelectedItem;
        if (item != null) 
        {
          Point scrollPos = panelHScroll.AutoScrollPosition;
          m_collectionIdentifier.Remove(item);
          ResetSelection();
          UpdateItems();
          panelHScroll.AutoScrollPosition = new Point(-scrollPos.X, -scrollPos.Y);
        }
      }
    }

    private void btnEdit_Click(object sender, System.EventArgs e)
    {
      ${doQualifiedClassName} item = SelectedItem;
      if (item != null) 
      {
        Type itemType = item.GetType();
        System.Windows.Forms.Form dialog = Locator.Instance.MetaDataManager.CreateGui(itemType);
        PropertyInfo property = dialog.GetType().GetProperty(itemType.Name);
        if (property != null) 
        {
          property.SetValue(dialog, item, null);
          dialog.ShowDialog(this);
#if($primitivePropertiesCount>0)
#set($propertyNameUpper=${primitiveProperties.get(0).nameFirstUpper()})
          int selectedIndex = list${propertyNameUpper}.SelectedIndex;
#end
          UpdateItems();
#if($primitivePropertiesCount>0)
#set($propertyNameUpper=${primitiveProperties.get(0).nameFirstUpper()})
          list${propertyNameUpper}.SelectedIndex = selectedIndex;
#end
        }
      }
    }

