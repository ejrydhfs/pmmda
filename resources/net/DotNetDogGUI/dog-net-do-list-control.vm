    private void ResetIdentifier() 
    {
      if (m_collectionIdentifier != null) 
      {
        if (m_collectionIdentifier.CollectionType == CollectionType.Set) 
        {
          IEnumerator enumerator = m_collectionIdentifier.Set.GetEnumerator();
          if (enumerator.MoveNext()) 
          {
            m_currentItem = (${doQualifiedClassName}) enumerator.Current;
          }
          else 
          {
            m_currentItem = null;
          }
        }
        else 
        {
          m_currentIndex = 0;
        }
        
        bool isBag = m_collectionIdentifier.CollectionType == CollectionType.Bag;
        bool isList = m_collectionIdentifier.CollectionType == CollectionType.List;
        btnMoveUp.Visible = isList;
        btnMoveDown.Visible = isList;
#foreach($primitiveProperty in $primitiveProperties)
#set($propertyNameUpper=${primitiveProperty.nameFirstUpper()})
        label${propertyNameUpper}.Enabled = isBag;
#end
        if (m_collectionIdentifier.Count > 0) 
        {
          vScrollBar.Maximum = m_collectionIdentifier.Count - 1;
        }
        else 
        {
          vScrollBar.Maximum = 0;
        }
        vScrollBar.LargeChange = VisibleItemCount;
        btnAdd.Enabled = !m_collectionIdentifier.ReadOnly;
        UpdateItems();
      }
    }

    private void ClearControls() 
    {
