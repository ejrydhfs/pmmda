    protected virtual void btnSave_Click(object sender, System.EventArgs e)
    {
      if (${doFieldName} != null)
      {
        this.Enabled = false;
        labelSaving.Visible = true;
        this.Refresh();
        try
        {
          Locator.Instance.DataObjectManager.DataObjectHandler.Store(${doFieldName});
        }
        catch (Exception ex)
        {
          MessageBox.Show(this, ${quotes}Could not save ${doClassNameFirstLower}.${quotes} + Environment.NewLine + ex.Message, ${quotes}Save ${doClassNameFirstLower}${quotes}, MessageBoxButtons.OK, MessageBoxIcon.Error);
        }
        finally 
        {
          labelSaving.Visible = false;
          this.Enabled = true;
        }
      }
    }
	
