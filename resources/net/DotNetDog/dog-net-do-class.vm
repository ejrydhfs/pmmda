${spaces}    {
${spaces}      get
${spaces}      {
${spaces}        if (m_id == null)
${spaces}        {
${spaces}          m_persistenceState = PersistenceState.New;
${spaces}        }
${spaces}        else
${spaces}        {
${spaces}          switch (m_persistenceState)
${spaces}          {
${spaces}            case PersistenceState.New:
${spaces}              m_persistenceState = PersistenceState.Unchanged;
${spaces}              break;
${spaces}            default:
${spaces}              break;
${spaces}          }
${spaces}        }
${spaces}        return m_persistenceState;
${spaces}      }
