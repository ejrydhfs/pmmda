${spaces}    /// <summary>
${spaces}    /// Changes the objects pesistence state after synchronisation with the database.
${spaces}    /// This method is called by the persistence handler.
${spaces}    /// </summary>
${spaces}    public void Commit()
${spaces}    {
${spaces}       switch (m_persistenceState)
${spaces}       {
${spaces}         case PersistenceState.New:
${spaces}           if (m_id != null)
${spaces}           {
${spaces}             m_persistenceState = PersistenceState.Unchanged;
${spaces}           }
${spaces}           break;
${spaces}         case PersistenceState.Unchanged:
${spaces}         case PersistenceState.Modified:
${spaces}           m_persistenceState = PersistenceState.Unchanged;
${spaces}           break;
${spaces}         case PersistenceState.Deleted:
${spaces}           m_persistenceState = PersistenceState.Destroyed;
${spaces}           foreach (IDataObject deletedChild in m_deletedChildren)
${spaces}           {
${spaces}             deletedChild.Commit();
${spaces}           }
${spaces}           m_deletedChildren.Clear();
${spaces}           break;
${spaces}         case PersistenceState.Destroyed:
${spaces}           break;
${spaces}       }
