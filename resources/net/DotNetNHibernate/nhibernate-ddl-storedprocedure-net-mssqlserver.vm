## printStoredProcedure
## Prints the SQL statement "CREATE PROCEDURE" for a specified class.
## For every recursion there are two stored procedures created: one with
## the parameter id and another with the id and the max depth as the
## abort criterion as parameters.
#macro(printStoredProcedure $class)
#set($dataObjectStereoTyp="DataObject")
#if(${dataObjectStereoTyp.equalsIgnoreCase(${class.getStereotype()})})
#if(${class.booleanValueOfTag("persistence")})
#set($schemaName=${class.retrievePackage().valueOfTag("orm-schema")})
#if(!${schemaName})#set($schemaName="")#end
#set($table=${class.getAttribute(".net-nhibernate-table-name")})
#set($fullTableName="${schemaName}.${table}")
#set($shouldGenerateFkIndex=${configuration.getProperty("net.nhibernate.generate-fk-index").equalsIgnoreCase("true")})
#set($properties=${netHelper.getAllProperties(${class})})
#set($indexedProperties=${netHelper.getAllIndexedProperties(${class})})
#set($hasAncestor=${class.retrieveAncestors().size()}>0)
#set($inheritanceStrategy=${class.getAttribute(".net-nhibernate-inheritance-strategy")})
#set($primaryKey="ID")
#isDataObject($class $isDataObject)

#set($storedProcName="getAll${shortClassName}sById_SP")
#set($storedProc="${table}_SP")

/* Stored procedure ${storedProcName} */
if exists (select * from dbo.sysobjects where id = object_id(N'[${storedProcName}]') and OBJECTPROPERTY(id, N'IsProcedure') = 1)
drop procedure [${storedProcName}]
GO
CREATE PROCEDURE [${storedProcName}] @id [int] AS
BEGIN
	SET NOCOUNT ON;
	
	WITH [${storedProc}](#printAllStoredProcProperties(${class} ""))
	AS (
		SELECT #printAllStoredProcProperties(${class} "")
		
		FROM ${table} 
		WHERE [${primaryKey}]=@id
		UNION ALL
			SELECT #printAllStoredProcProperties(${class} ${table})
			FROM ${table}, ${storedProc}
			WHERE (#printWhereClauseRestriction($class))
			##WHERE (${storedProc}.[LEFT_FK]=${table}.[ID] OR ${storedProc}.[RIGHT_FK]=${table}.[ID])
	)
-- Outer select from the CTE
SELECT #printAllStoredProcProperties(${class} "") 
FROM ${storedProc}
END;
GO
#end
#end
#end
##
## printStoredProcedure
## Prints the SQL statement "CREATE PROCEDURE" for a specified class.
## For every recursion there are two stored procedures created: one with
## the parameter id and another with the id and the max depth as the
## abort criterion as parameters.
#macro(printStoredProcedureWithMaxDepth $class)
#set($dataObjectStereoTyp="DataObject")
#if(${dataObjectStereoTyp.equalsIgnoreCase(${class.getStereotype()})})
#if(${class.booleanValueOfTag("persistence")})
#set($schemaName=${class.retrievePackage().valueOfTag("orm-schema")})
#if(!${schemaName})#set($schemaName="")#end
#set($table=${class.getAttribute(".net-nhibernate-table-name")})
#set($fullTableName="${schemaName}.${table}")
#set($shouldGenerateFkIndex=${configuration.getProperty("net.nhibernate.generate-fk-index").equalsIgnoreCase("true")})
#set($properties=${netHelper.getAllProperties(${class})})
#set($indexedProperties=${netHelper.getAllIndexedProperties(${class})})
#set($hasAncestor=${class.retrieveAncestors().size()}>0)
#set($inheritanceStrategy=${class.getAttribute(".net-nhibernate-inheritance-strategy")})
#set($primaryKey="ID")
#isDataObject($class $isDataObject)
#set($classAttribute=".net-data-object-class")
#set($shortClassName="${class.getAttribute(${classAttribute})}")

#set($storedProcName="getAll${shortClassName}sByIdWithMaxDepth_SP")
#set($storedProc="${table}_SP")

/* Stored procedure ${storedProcName} */
if exists (select * from dbo.sysobjects where id = object_id(N'[${storedProcName}]') and OBJECTPROPERTY(id, N'IsProcedure') = 1)
drop procedure [${storedProcName}]
GO
CREATE PROCEDURE [${storedProcName}] @id [int], @depth [int] AS
BEGIN
	SET NOCOUNT ON;
	
	WITH [${storedProc}](#printAllStoredProcProperties(${class} ""), depth)
	AS (
		SELECT #printAllStoredProcProperties(${class} ""), 1
		
		FROM ${table} 
		WHERE [${primaryKey}]=@id
		UNION ALL
			SELECT #printAllStoredProcProperties(${class} ${table}), ${storedProc}.depth+1
			FROM ${table}, ${storedProc}
			WHERE (${storedProc}.depth <= @depth) AND (#printWhereClauseRestriction($class))
	)
-- Outer select from the CTE
SELECT #printAllStoredProcProperties(${class} "") 
FROM ${storedProc}
END;
GO
