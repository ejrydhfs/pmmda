/** 
 * The transformer is responsible to transform a tree of data objects into its
 * lighthweight tree representation.
 */
public class LwTransformer {
#foreach($class in $classes)
#isLightweightDataObject($class $isLightweightDataObject)
#if($isLightweightDataObject)
#set($boClass=${class.getAttribute("bo-mo-class")})
#set($lwClass=${class.getAttribute("bo-lw-class")})
  /** 
   * Transforms a data object specific class into its lightweight representation.
   * @param item data object instance to synchronize.
   * @return the lightweight representation of the data object instance
   */
  public static ${lwClass} transform(${boClass} item) {
    assert item != null;
    ${lwClass} lw = new ${lwClass}(item.getId());
    synchronize(item, lw);
    return lw;
  }
  
#end
#end
#foreach($class in $classes)
#isLightweightDataObject($class $isLightweightDataObject)
#if($isLightweightDataObject)
#set($boClass=${class.getAttribute("bo-mo-class")})
#set($lwClass=${class.getAttribute("bo-lw-class")})
  /** 
   * Synchronizes a data object specific class into its lightweight representation.
   * @param item data object instance to synchronize.
   * @param lw the lightweight representation to synchronize.
   */
  public static void synchronize(${boClass} item, ${lwClass} lw) {
    assert (item != null) && (lw != null);
#set($ancestors=${class.retrieveAncestors()})
#foreach($ancestor in $ancestors)
#isLightweightDataObject($ancestor $isAncestorLw)
#if($isAncestorLw)
    synchronize((${ancestor.getAttribute("bo-mo-class")})item, (${ancestor.getAttribute("bo-lw-class")})lw); 
#end	
#end	
#set($properties=${class.getProperties()})
#foreach ($property in $properties)
#if(${property.booleanValueOfTag("bo-lightweight")})
#isTypeLightweigth($model $property $isTypeLightweigth)
#if($isTypeLightweigth)
    if (item.get${property.nameFirstUpper()}() != null) {
      lw.set${property.nameFirstUpper()}(transform(item.get${property.nameFirstUpper()}()));
    }
#else
#getterName($property $getter)
    lw.set${property.nameFirstUpper()}(item.${getter}());
#end
#end
#end
## infers if an iterator should be declared.
#set($needIterator=false)
#set($aggregations=${class.getIndexedProperties()})
#foreach ($aggregation in $aggregations) 
#if(${aggregation.booleanValueOfTag("bo-lightweight")})
#getType($model $aggregation $type)
#isTypeLightweigth($model $aggregation $isTypeLightweigth)
#if($isTypeLightweigth)
    for (${type.getAttribute("bo-mo-class")} i : item.get${aggregation.nameFirstUpperPlural()}()) {
      lw.add${aggregation.nameFirstUpperSingular()}((i != null) ? transform(i) : null);
    }
#end
#end
#end
  }
  
#end
#end
}
