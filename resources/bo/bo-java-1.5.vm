  /**
   * Convenience method to set the value of a foreign key.
   * @param bean object which property should be set.
   * @param property property to be set.
   * @param key key identifier to set.
   * @pre (bean != null) && (property != null) && (key != null)
   */
   protected final void setForeignKey(DataObject bean, String property,
      Integer key) {
    assert((bean != null) && (property != null));
    try {
      Field field = bean.getClass().getDeclaredField(property);
      if (field != null) {
        field.setAccessible(true);
        field.set(bean, key);
      }
    } catch (NoSuchFieldException e) {
      assert(false);
    } catch (IllegalArgumentException e) {
      assert(false);
    } catch (IllegalAccessException e) {
      assert(false);
    }
  }
#end

  /** 
   * Copies deeply all the attributes of the class and its ancestors.
   * @param clone the copy which deep copy should be generated.
   */
  protected void copy(${className} clone) {
#if($hasAncestors)
    super.copy(clone);
#end
#foreach ($property in $properties)
#isTypeModel($model $property $isTypeModel)
#if($isTypeModel)
#set($lName=${property.nameFirstLower()})
    if (${lName} != null) {
      clone.${lName} = ${lName}.copy();
    }
#end 
#end
#foreach ($aggregation in $aggregations) 
#set($lName = ${aggregation.nameFirstLower()})
#set($itemType = ${aggregation.retrieveTypeClassName()})
#set($keyType=${aggregation.getAttribute("bo-key-class")})
    clone.${lName} = #containerCreation($aggregation);
#if(${cartridge.isOrdered(${aggregation})})
    for (${keyType} key : ${lName}.keySet()) {
      clone.${lName}.put(key, ${lName}.get(key));
    }
#else
    for (int i = 0; i < ${lName}.size(); i++) {
      clone.${lName}.add(${lName}.get(i).copy());
    }
#end
#end
  }

  /** 
   * Implements the visitor pattern in the data object class. The accept
   * method dispatches the visitor to all relevant children of the ancestors
   * and its children. A relevant child is always another data object.
   * @param visitor visitor to act on the data object.
   */  
  protected void traverse(Visitor visitor) {
#if($hasAncestors)
    super.traverse(visitor);
#end
#foreach ($property in $properties)
#isTypeModel($model $property $isTypeModel)
#if($isTypeModel)
    if (${property.nameFirstLower()} != null) {
      ${property.nameFirstLower()}.accept(visitor);
    }
#end
#end
#foreach ($aggregation in $aggregations) 
#isTypeModel($model $aggregation $isTypeModel)
#if($isTypeModel)
#set($upName = ${aggregation.nameFirstUpperPlural()})
#getType($model $aggregation $type)
    for (${type.getAttribute("bo-mo-class")} item : get${upName}()) {
      item.accept(visitor);
    }
#end
#end
  }  

