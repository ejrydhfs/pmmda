  /** 
   * Implements the visitor pattern in the lightweight data object class. The 
   * accept method dispatches the visitor to all its relevant children. A 
   * relevant child is always another data object.
   * @param visitor visitor to act on the data object.
   * @pre visitor != null
   */  
  public void accept(LwVisitor visitor) {
    assert(visitor != null);
    visitor.setDepth(visitor.getDepth() + 1);
    visitor.visit(this);
    traverse(visitor);
    visitor.setDepth(visitor.getDepth() - 1);
  }

  /** 
   * Creates and returns a deep copy of the object and its descendants. The 
   * properties containing keys are not cloned because they are immutable.
   * @return a deep copy of the instance.
   */
  public ${className} deepCopy() {
    ${className} clone = null;
    try {
      clone = (${class.getAttribute("bo-lw-class")})clone();
    } catch (CloneNotSupportedException e) {
      // impossible exception because data object is cloneable.
      return null;
    }
#foreach ($property in $properties)
#isLightweightDataObject($property $isLightweightDataObject)
#if($isLightweightDataObject)
#set($lName=${property.nameFirstLower()})
    if (${lName} != null) {
      clone.${lName} = (${property.getReferenceClass().getAttribute("bo-lw-class")})${lName}.getClone();
    }
#end 
#end
#foreach ($aggregation in $aggregations) 
#if(${aggregation.booleanValueOfTag("bo-lightweight")})
#getType($model $aggregation $type)
#set($itemType = ${type.getAttribute("bo-lw-class")})
#set($lName = ${aggregation.nameFirstLower()})
    clone.${lName} = new ${aggregation.valueOfTag("bo-container-class")}<$itemType>();
    for (int i = 0; i < ${lName}.size(); i++) {
      clone.${lName}.add(${lName}.get(i).deepCopy());
    }
#end
#end
    return clone;
  }

  /** 
   * Implements the visitor pattern in the ligthweight data object class. The 
   * accept method dispatches the visitor to all relevant children of the 
   * ancestors and its children. A relevant child is always another lightweigth 
   * data object.
   * @param visitor visitor to act on the data object.
   */  
  protected void traverse(LwVisitor visitor) {
#if($hasAncestors)
    super.traverse(visitor);
#end
#foreach ($property in $properties)
#if(${property.booleanValueOfTag("bo-lightweight")})
#isTypeLightweigth($model $property $isTypeLightweigth)
#if(${isTypeLightweigth} && !${property.booleanValueOfAttribute("bo-used-for-navigation")})
    if (${property.nameFirstLower()} != null) {
      ${property.nameFirstLower()}.accept(visitor);
    }
#end
#end
#end
#foreach ($aggregation in $aggregations) 
#if(${aggregation.booleanValueOfTag("bo-lightweight")})
#isTypeLightweigth($model $aggregation $isTypeLightweigth)
#if(${isTypeLightweigth} && !${aggregation.booleanValueOfAttribute("bo-used-for-navigation")})
#set($upName = ${aggregation.nameFirstUpperPlural()})
#getType($model $aggregation $type)
    for (${type.getAttribute("bo-lw-class")} item : get${upName}()) {
      item.accept(visitor);
    }
#end
#end
#end
  }  
