#emitFileHeader()
#set($packageName=${package.getAttribute("bo-lw-package")})

package ${packageName};

#set($visited=${cartridge.computeTransitiveClosure(${package})})
#set($imports=${cartridge.createImports(${packageName})})
#set($importStatements=${imports.getImportStatements(4)})
#foreach($importStatement in $importStatements) 
import $importStatement;
