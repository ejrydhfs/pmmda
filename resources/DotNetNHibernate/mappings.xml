      <obsolete-tag name="or-column-size" type="java.lang.String" context="indexed-property" />
      <obsolete-tag name="or-column-type" type="ch.bbv.mda.cartridges.JdbcTypeCode" context="indexed-property" />
      <obsolete-tag name=".net-nhibernate-persistence" type="boolean" context="indexed-property" />
    </obsolete-tags>
    <properties>
      <property name="net.nhibernate.database-provider" default-value="MySQL"/>
      <property name="net.nhibernate.table-prefix" default-value=""/>
