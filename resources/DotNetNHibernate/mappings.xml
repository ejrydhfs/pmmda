      <property name="net.nhibernate.column-prefix" default-value=""/>
      <property name="net.nhibernat.column-postfix" default-value=""/>
      <property name="net.nhibernate.generate-fk-index" default-value="false"/>
      <property name="net.nhibernate.root-folder" default-value="./gendir"/>
