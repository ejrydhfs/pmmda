## printTrigger
## Prints the triggers for timestamps
## @param class The class for which the triggers are created.
#macro(printTrigger $class)
#set($dataObjectStereoTyp="DataObject")
#if(${dataObjectStereoTyp.equalsIgnoreCase(${class.getStereotype()})})
#if(${class.booleanValueOfTag("persistence")})
#set($schemaName=${class.retrievePackage().valueOfTag("orm-schema")})
#if(!${schemaName})#set($schemaName="")#end
#set($table=${class.getAttribute(".net-nhibernate-table-name")})
#set($fullTableName="${schemaName}.${table}")
#set($hasAncestor=${class.retrieveAncestors().size()}>0)
#set($inheritanceStrategy=${class.getAttribute(".net-nhibernate-inheritance-strategy")})
#if($inheritanceStrategy=="Table per subclass" && ${hasAncestor})
#set($primaryKey="${baseClass.getName()}_ID_FK")
#else
#set($primaryKey="ID")
#end
#if(!${hasAncestor})
SET QUOTED_IDENTIFIER OFF 
GO
SET ANSI_NULLS ON 
GO
CREATE TRIGGER [${table}_UPDATE] ON [${table}] 
FOR UPDATE, INSERT
AS
    SET NOCOUNT ON
	UPDATE [${table}] SET TS = GETDATE()
	FROM   [${table}], INSERTED
        WHERE  [${table}].ID = INSERTED.ID
    SET NOCOUNT OFF
GO
SET QUOTED_IDENTIFIER OFF 
GO
SET ANSI_NULLS ON 
GO
#end
#end
#end
#end
