##
## prints ddl for a table holding a reference code
##
#macro(printReferenceCodeTable $class)
#set($codeType=${model.getCodeTypeMgr().retrieve(${class})})
#set($storageKind=${codeType.getStorageKind()})
#if(${storageKind.getShortDescription()}=="database")
#set($table=${class.getAttribute(".net-nhibernate-table-name")})
/* Reference Code Table ${table} */
if exists (select * from dbo.sysobjects where id = object_id(N'[${table}]') and OBJECTPROPERTY(id, N'IsUserTable') = 1)
drop table [${table}]
GO
CREATE TABLE [${table}] (
	Code INTEGER NOT NULL,
	ShortDescription VARCHAR(50) NOT NULL,
	Description VARCHAR(255) NULL,
	SortOrder INTEGER NULL,
	ValidFrom DATETIME NULL,
	ValidTo DATETIME NULL,
	Active BIT NOT NULL 
        CONSTRAINT [DF_${table}_Active] DEFAULT ((1)),
        CONSTRAINT [PK_${table}] PRIMARY KEY CLUSTERED (Code) ON [PRIMARY]
) ON [PRIMARY]
GO
CREATE UNIQUE INDEX ${table}_UniqueShortDescription ON 
  [${table}](ShortDescription);
GO
