## printTable
## Prints the SQL statement "CREATE TABLE" for a specified class.
#macro(printTable $class)
#set($dataObjectStereoTyp="DataObject")
#if(${dataObjectStereoTyp.equalsIgnoreCase(${class.getStereotype()})})
#if(${class.booleanValueOfTag("persistence")})
#set($schemaName=${class.retrievePackage().valueOfTag("orm-schema")})
#if(!${schemaName})#set($schemaName="")#end
#set($table=${class.getAttribute(".net-nhibernate-table-name")})
#set($fullTableName="${schemaName}.${table}")
#set($shouldGenerateFkIndex=${configuration.getProperty("net.nhibernate.generate-fk-index").equalsIgnoreCase("true")})
#set($properties=${netHelper.getAllProperties(${class})})
#set($indexedProperties=${netHelper.getAllIndexedProperties(${class})})
#set($hasAncestor=${class.retrieveAncestors().size()}>0)
#set($inheritanceStrategy=${class.getAttribute(".net-nhibernate-inheritance-strategy")})
#set($primaryKey="ID")
#isDataObject($class $isDataObject)

/* Table ${table} */
if exists (select * from dbo.sysobjects where id = object_id(N'[${table}_UPDATE]') and OBJECTPROPERTY(id, N'IsTrigger') = 1)
drop trigger [${table}_UPDATE]
GO
if exists (select * from dbo.sysobjects where id = object_id(N'[${table}]') and OBJECTPROPERTY(id, N'IsUserTable') = 1)
drop table [${table}]
GO
CREATE TABLE [${table}] (
#if($inheritanceStrategy=="Table per subclass")
#if(${hasAncestor})
#set($baseClass=${class.retrieveAncestors().get(0)})
  ${baseClass.getName()}_ID_FK INTEGER NOT NULL,
#set($primaryKey="${baseClass.getName()}_ID_FK")
#else
  ID INTEGER IDENTITY NOT NULL PRIMARY KEY CLUSTERED,
  TS DATETIME NOT NULL DEFAULT (GETDATE()),
#end
#end
#if($inheritanceStrategy=="Table per concrete class" || $inheritanceStrategy=="Table per class hierarchy")
  ID INTEGER IDENTITY NOT NULL PRIMARY KEY CLUSTERED,
  TS DATETIME NOT NULL DEFAULT (GETDATE()),
#end
#if($inheritanceStrategy=="Table per class hierarchy")
  TYPE VARCHAR(255) NOT NULL,
#end
#printPropertyRows(${class})
#printIndexesForIndexedProperties(${class})
)
GO
#printTrigger(${class})
#printIndex(${class})
#if($inheritanceStrategy=="Table per subclass" || $inheritanceStrategy=="Table per concrete class")
#foreach($derivedClass in ${netHelper.getDerivedClasses(${class})})
#printTable(${derivedClass})
#end
#end
#end
#end
