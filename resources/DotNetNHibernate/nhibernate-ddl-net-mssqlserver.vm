INSERT INTO ${table} (Code,ShortDescription,Description,SortOrder,ValidFrom,ValidTo,Active)
  VALUES(${codeValue.getCodeId()},'${codeValue.getShortDescription()}','${codeValue.getDescription()}',${codeValue.getSortOrder()},${codeStart},${codeEnd},1);
GO
