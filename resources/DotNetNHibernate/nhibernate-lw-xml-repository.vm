#set($baseClass=${class.retrieveAncestors().get(0)})
${spaces}  <key column=${quotes}${baseClass.getName()}_ID_FK${quotes}/>
#else
${spaces}<class name=${quotes}${className}${quotes} table=${quotes}${tableName}${quotes}>
#end
#end
#if($inheritanceStrategy=="Table per concrete class")
## For each class there is a table which contains all properties (includes derived proeprties).
${spaces}<class name=${quotes}${className}${quotes} table=${quotes}${tableName}${quotes}>
