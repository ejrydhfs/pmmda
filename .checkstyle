<?xml version="1.0" encoding="UTF-8"?>
<fileset-config file-format-version="1.0.0">
    <fileset name="pmMDA" enabled="true" check-config-name="pmMDA configuration">
        <file-match-pattern match-pattern="[.java]$" include-pattern="true"/>
        <file-match-pattern match-pattern="ch/bbv/bog" include-pattern="false"/>
        <file-match-pattern match-pattern="ch/bbv/transport" include-pattern="false"/>
    </fileset>
</fileset-config>
