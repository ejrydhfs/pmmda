<?xml version="1.0" encoding="ISO-8859-1"?>

<!ELEMENT meta-model (business-objects)>
<!ELEMENT business-objects (business-object*)>

<!ELEMENT business-object (attribute*)>
<!ATTLIST business-object 
	name CDATA #REQUIRED
	description CDATA #IMPLIED>

<!ELEMENT attribute (context? controlled-attributes? dependant-attributes? inits? checks? validations? formulas?)>
<!ATTLIST attribute 
	name CDATA #REQUIRED
	description CDATA #IMPLIED
	indexed (TRUE | FALSE) "FALSE">

<!ELEMENT context (formal-param*)>
<!ELEMENT formal-param (EMPTY)>
<!ATTLIST formal-param 
	name CDATA #REQUIRED
  type CDATA #REQUIRED 
  description CDATA #IMPLIED> 

<!ELEMENT discriminator (actual-param*)>
<!ATTLIST discriminator
  description CDATA #IMPLIED> 

<!ELEMENT actual-param (EMPTY)>
<!ATTLIST actual-param 
	name CDATA #REQUIRED
  value CDATA #REQUIRED> 

<!ELEMENT controlled-attributes (controlled-attribute)>
<!ELEMENT controlled-attribute (discriminator attribute-name*)>

<!ELEMENT dependant-attributes (dependant-attribute)>
<!ELEMENT dependant-attribute (attribute-name*)>

<!ELEMENT inits (formula*)>
<!ELEMENT checks (rule*)>
<!ELEMENT validations (formula*)>
<!ELEMENT formulas (formula*)>

<!ELEMENT formula (discriminator?)>
<!ATTLIST formula 
	expression CDATA #REQUIRED>

<!ELEMENT rule (EMPTY)>
