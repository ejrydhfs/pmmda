<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE descriptor-repository PUBLIC
       "-//Apache Software Foundation//DTD OJB Repository//EN"
       "repository.dtd"
[
	<!ENTITY repository-database SYSTEM "repository_database.xml">
	<!ENTITY repository-internal SYSTEM "repository_internal.xml">
	<!ENTITY repository-lightweight-objects SYSTEM "ojb_lw_user.xml">
	<!ENTITY repository-business-objects SYSTEM "ojb_bo_user.xml">
]>

<descriptor-repository version="1.0" isolation-level="read-uncommitted"
        proxy-prefetching-limit="50">
 &repository-database;
  &repository-internal;
  &repository-lightweight-objects;
  &repository-business-objects;
</descriptor-repository>
