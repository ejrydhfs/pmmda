      </fileset>
    </replaceregexp>
    <replaceregexp match="commons-io-(.*?)\.jar" replace="${commons-io.lib}" flags="i">
      <fileset dir="${scripts.dir}">
        <include name="**/*.bat" />
      </fileset>
    </replaceregexp>
    <replaceregexp match="commons-logging-(.*?)\.jar" replace="${commons-logging.lib}" flags="i">
      <fileset dir="${scripts.dir}">
