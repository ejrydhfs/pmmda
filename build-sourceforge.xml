      </fileset>
    </replaceregexp>
    <replaceregexp match="forms-(.*?)\.jar" replace="${forms.lib}" flags="i">
      <fileset dir="${scripts.dir}">
        <include name="**/*.bat" />
      </fileset>
    </replaceregexp>
    <replaceregexp match="glazedlists-(.*?)\.jar" replace="${glazedlists.lib}" flags="i">
      <fileset dir="${scripts.dir}">
        <include name="**/*.bat" />
      </fileset>
    </replaceregexp>
    <replaceregexp match="mysql-connector-(.*?)\.jar" replace="${mysql-connector.lib}" flags="i">
      <fileset dir="${scripts.dir}">
