<project name="pmMDA-sourceforge" basedir="." default="sourceforge">
  <property file="build.properties" />
  <import file="build-inits.xml" />
  <import file="build-examples.xml" />
  <property name="forrest.plugins-dir" value="${forrest.home}/build/plugins"/>
  <import file="${forrest.home}/main/forrest.build.xml" />

  <target name="clean" depends="dist-init" description="Clean the distribution directories">
    <delete dir="${dist.dir}" />
    <mkdir dir="${dist.dir}" />
  </target>

  <target name="compile-dist" depends="dist-init" description="compiles all java files of the projects dog, pmmda, documentor">
    <delete dir="${build.dir}" />
    <mkdir dir="${build.dir}" />
    <javac destdir="${build.dir}" srcdir="${src.dog.dir}:${src.pmmda.dir}:${src.documentor.dir}" includes="**/*.java,**/*.properties" compiler="modern" verbose="${compile.verbose}" debug="${compile.debug}" source="${compile.source}">
      <classpath refid="application.classpath" />
    </javac>
    <copy todir="${build.dir}">
      <fileset dir="${src.dog.dir}" includes="**/*.properties," />
    </copy>
    <copy todir="${build.dir}">
      <fileset dir="${src.pmmda.dir}" includes="**/*.properties," />
    </copy>
    <copy todir="${build.dir}/images">
      <fileset dir="${properties.dir}/images" />
    </copy>
  </target>

  <target name="pmmda-dist" depends="dist-init, init-tests, compile-dist, init-libs" description="Generates pmMDA distribution">
    <echo message="generate pmMDA binary and source distribution" />
    <delete dir="${pmmda-dist.dir}" />
    <mkdir dir="${pmmda-dist.dir}" />
    <mkdir dir="${pmmda-lib.dir}" />
    <mkdir dir="${pmmda-model.dir}" />
    <mkdir dir="${pmmda-src.dir}" />
    <mkdir dir="${pmmda-src-dog-idl.dir}" />
    <mkdir dir="${pmmda-src-dog-corba.dir}" />
    <mkdir dir="${pmmda-src-etc.dir}" />
    <mkdir dir="${pmmda-resources.dir}" />

    <copy todir="${pmmda-model.dir}">
      <fileset dir="${model.dir}/test-model">
        <include name="**/*.zargo" />
        <include name="**/*.xml" />
      </fileset>
    </copy>
    <copy todir="${pmmda-src-dog-corba.dir}">
      <fileset dir="${src.dir}/corba-framework">
        <exclude name="**/*CVS*" />
      </fileset>
    </copy>
    <copy todir="${pmmda-src-dog-idl.dir}">
      <fileset dir="${src.dir}/idl-framework">
        <exclude name="**/*CVS*" />
      </fileset>
    </copy>
    <copy todir="${pmmda-src-etc.dir}">
      <fileset dir="${src.dir}/etc">
        <exclude name="**/*CVS*" />
      </fileset>
    </copy>
    <echo message="copy pmMDA needed library files" />
    <copy file="${lib.dir}/${commons-beanutils.lib}" todir="${pmmda-lib.dir}" />
    <copy file="${lib.dir}/${commons-cli.lib}" todir="${pmmda-lib.dir}" />
    <copy file="${lib.dir}/${commons-collections.lib}" todir="${pmmda-lib.dir}" />
    <copy file="${lib.dir}/${commons-configuration.lib}" todir="${pmmda-lib.dir}" />
    <copy file="${lib.dir}/${commons-lang.lib}" todir="${pmmda-lib.dir}" />
    <copy file="${lib.dir}/${commons-logging.lib}" todir="${pmmda-lib.dir}" />
    <copy file="${lib.dir}/${commons-logging-api.lib}" todir="${pmmda-lib.dir}" />
    <copy file="${lib.dir}/${forms.lib}" todir="${pmmda-lib.dir}" />
    <copy file="${lib.dir}/${glazedlists.lib}" todir="${pmmda-lib.dir}" />
    <copy file="${lib.dir}/${jgraph.lib}" todir="${pmmda-lib.dir}" />
    <copy file="${lib.dir}/${jgraphaddons.lib}" todir="${pmmda-lib.dir}" />
    <copy file="${lib.dir}/${nsuml.lib}" todir="${pmmda-lib.dir}" />
    <copy file="${lib.dir}/${velocity.lib}" todir="${pmmda-lib.dir}" />
    <copy file="${lib.dir}/${velocity-dep.lib}" todir="${pmmda-lib.dir}" />
    <copy file="${lib.dir}/${xpp3.lib}" todir="${pmmda-lib.dir}" />
    <copy file="${lib.dir}/${xstream.lib}" todir="${pmmda-lib.dir}" />
    <copy file="${scripts.dir}/dist/pmMDA.bat" todir="${pmmda-dist.dir}" />
    <copy file="${scripts.dir}/dist/pmMDA.properties" todir="${pmmda-dist.dir}" />
    <copy file="${scripts.dir}/dist/logging.properties" todir="${pmmda-dist.dir}" />
    <copy file="${src.pmmda.dir}/ReleaseNotes.txt" todir="${pmmda-dist.dir}" />
    <copy todir="${pmmda-resources.dir}">
      <fileset dir="${resources.dir}">
        <exclude name="**/*CVS*" />
      </fileset>
    </copy>
    <property name="jars.list" value="${commons-beanutils.lib} ${commons-cli.lib} ${commons-collections.lib} ${commons-logging.lib} ${commons-logging-api.lib} ${forms.lib} ${glazedlists.lib} ${nsuml.lib} ${velocity.lib} ${velocity-dep.lib} ${xpp3.lib} ${xstream.lib}" />
    <manifest file="${pmmda-lib.dir}/Manifest.mf">
      <attribute name="Main-Class" value="ch.bbv.mda.ui.MdaApplication" />
      <attribute name="Class-Path" value="${jars.list}" />
      <section name="pmMDA">
        <attribute name="Built-By" value="${user.name}" />
        <attribute name="Specification-Title" value="pmMDA" />
        <attribute name="Specification-Version" value="${pmmda.version}" />
        <attribute name="Specification-Vendor" value="${user.name}" />
        <attribute name="Implementation-Title" value="pmMDA" />
        <attribute name="Implementation-Version" value="${pmmda.version}" />
        <attribute name="Implementation-Vendor" value="${user.name}" />
      </section>
    </manifest>
    <jar jarfile="${pmmda-lib.dir}/${pmmda.name}.jar" compress="true" index="true" manifest="${pmmda-lib.dir}/Manifest.mf">
      <fileset dir="${build.dir}" excludes="ch/bbv/documentor/**,**/pmmda.properties,**/*.html,**/*.xml,**/*.sql" />
    </jar>
    <delete file="${pmmda-lib.dir}/Manifest.mf" />
    <jar destfile="${dist.dir}/${pmmda.name}-src-${pmmda.version}.jar" compress="true" index="true">
      <fileset dir="${src.pmmda.dir}" excludes="ch/bbv/bog/**,ch/bbv/documentor/**" />
    </jar>
    <echo message="copy all examples" />
    <antcall target="pmmda-examples" />
    <echo message="generate pmMDA distribution as zipped tar file" />
    <tar destfile="${dist.dir}/${pmmda.name}-${pmmda.version}.tar.gz" basedir="${pmmda-dist.dir}" compression="gzip" />
    <echo message="generate archive files of all librairies" />
    <zip destfile="${dist.dir}/${pmmda.name}-dev-libs-${pmmda.version}.zip" basedir="${lib.dir}" update="true" />
    <zip destfile="${dist.dir}/${pmmda.name}-dev-metrics-libs-${pmmda.version}.zip" basedir="${scripts.lib.dir}" update="true" />
  </target>

  <target name="dog-dist" description="Generates DOG distribution" depends="dist-init">
    <delete dir="${dog-dist.dir}" />
    <mkdir dir="${dog-dist.dir}" />
    <mkdir dir="${dog-lib.dir}" />
    <copy file="${lib.dir}/${antlr.lib}" todir="${dog-lib.dir}" />
    <copy file="${lib.dir}/${commons-beanutils.lib}" todir="${dog-lib.dir}" />
    <copy file="${lib.dir}/${commons-dbcp.lib}" todir="${dog-lib.dir}" />
    <copy file="${lib.dir}/${commons-lang.lib}" todir="${dog-lib.dir}" />
    <copy file="${lib.dir}/${commons-logging.lib}" todir="${dog-lib.dir}" />
    <copy file="${lib.dir}/${commons-logging-api.lib}" todir="${dog-lib.dir}" />
    <copy file="${lib.dir}/${commons-pool.lib}" todir="${dog-lib.dir}" />
    <copy file="${lib.dir}/${mysql-connector.lib}" todir="${dog-lib.dir}" />
    <copy file="${src.dog.dir}/ReleaseNotes.txt" todir="${dog-dist.dir}" />
    <jar jarfile="${dog-lib.dir}/${dog.name}-${dog.version}.jar" compress="true" index="true">
      <fileset dir="${build.dir}" excludes="ch/bbv/mda/**,ch/bbv/documentor/**,**/*.html,**/*.xml,**/*.sql" />
    </jar>
    <jar destfile="${dist.dir}/${dog.name}-src-${dog.version}.jar" compress="true" index="true">
      <fileset dir="${src.dog.dir}" includes="*/**" />
    </jar>
  </target>

  <target name="pmmda-examples" depends="dist-init" description="Generates the pmMDA examples">
    <property name="pmmda-dist.dir" value="${dist.dir}/${pmmda.name}" />
    <property name="pmmda-work.dir" value="${pmmda-dist.dir}/work" />
    <property name="pmmda-ex.dir" value="${pmmda-work.dir}/example" />
    <property name="pmmda-ex-model.dir" value="${pmmda-ex.dir}/model" />
    <property name="pmmda-ex-data.dir" value="${pmmda-ex.dir}/db" />
    <property name="pmmda-ex-lib.dir" value="${pmmda-ex.dir}/test-lib" />
    <property name="pmmda-ex-gendir.dir" value="${pmmda-ex.dir}/gendir" />
    <property name="pmmda-ex-src.dir" value="${pmmda-ex.dir}/test-java" />
    <property name="pmmda-ex-classes.dir" value="${pmmda-ex.dir}/test-classes" />

    <echo message="copying the examples" />
    <mkdir dir="${pmmda-work.dir}" />
    <mkdir dir="${pmmda-ex.dir}" />
    <mkdir dir="${pmmda-ex-model.dir}" />
    <mkdir dir="${pmmda-ex-model.dir}/codes" />
    <mkdir dir="${pmmda-ex-src.dir}" />
    <mkdir dir="${pmmda-ex-data.dir}" />
    <mkdir dir="${pmmda-ex-lib.dir}" />

    <mkdir dir="${pmmda-ex-src.dir}" />
    <mkdir dir="${pmmda-ex-src.dir}/client" />
    <mkdir dir="${pmmda-ex-src.dir}/common" />
    <mkdir dir="${pmmda-ex-src.dir}/server" />

    <mkdir dir="${pmmda-ex-gendir.dir}" />
    <mkdir dir="${pmmda-ex-gendir.dir}/ojb-server" />
    <mkdir dir="${pmmda-ex-gendir.dir}/corba-idl" />
    <mkdir dir="${pmmda-ex-gendir.dir}/corba-common" />
    <mkdir dir="${pmmda-ex-gendir.dir}/corba-server" />
    <mkdir dir="${pmmda-ex-gendir.dir}/corba-client" />
    <mkdir dir="${pmmda-ex-gendir.dir}/j2ee-common" />
    <mkdir dir="${pmmda-ex-gendir.dir}/j2ee-server" />
    <mkdir dir="${pmmda-ex-gendir.dir}/j2ee-client" />
    <mkdir dir="${pmmda-ex-gendir.dir}/rich-client" />

    <mkdir dir="${pmmda-ex-classes.dir}" />
    <mkdir dir="${pmmda-ex-classes.dir}/rich-client" />
    <mkdir dir="${pmmda-ex-classes.dir}/j2ee-client" />
    <mkdir dir="${pmmda-ex-classes.dir}/corba-client" />
    <mkdir dir="${pmmda-ex-classes.dir}/j2ee-server" />
    <mkdir dir="${pmmda-ex-classes.dir}/corba-server" />

    <mkdir dir="${pmmda-ex.dir}/scripts" />
    <mkdir dir="${pmmda-ex.dir}/scripts/tests" />
    <copy todir="${pmmda-ex.dir}/scripts/tests">
      <fileset dir="${scripts.dir}/tests">
        <include name="**/*.bat" />
        <exclude name="**/*CVS*" />
      </fileset>
    </copy>

    <copy file="${model.dir}/test-model/test-model.zargo" todir="${pmmda-ex-model.dir}" />
    <copy todir="${pmmda-ex-src.dir}/client">
      <fileset dir="${test.client.dir}">
        <include name="**/*.java" />
        <exclude name="**/*CVS*" />
      </fileset>
    </copy>
    <copy todir="${pmmda-ex-src.dir}/common">
      <fileset dir="${test.common.dir}">
        <include name="**/*.java" />
        <exclude name="**/*CVS*" />
      </fileset>
    </copy>
    <copy todir="${pmmda-ex-src.dir}/server">
      <fileset dir="${test.server.dir}">
        <include name="**/*.java" />
        <exclude name="**/*CVS*" />
      </fileset>
    </copy>

    <copy file="${lib.dir}/hsqldb.jar" todir="${pmmda-ex-lib.dir}" />
    <copy file="${lib.dir}/${antlr.lib}" todir="${pmmda-ex-lib.dir}" />
    <copy file="${lib.dir}/${commons-beanutils.lib}" todir="${pmmda-ex-lib.dir}" />
    <copy file="${lib.dir}/${commons-cli.lib}" todir="${pmmda-ex-lib.dir}" />
    <copy file="${lib.dir}/${commons-collections.lib}" todir="${pmmda-ex-lib.dir}" />
    <copy file="${lib.dir}/${commons-dbcp.lib}" todir="${pmmda-ex-lib.dir}" />
    <copy file="${lib.dir}/${commons-lang.lib}" todir="${pmmda-ex-lib.dir}" />
    <copy file="${lib.dir}/${commons-logging.lib}" todir="${pmmda-ex-lib.dir}" />
    <copy file="${lib.dir}/${commons-logging-api.lib}" todir="${pmmda-ex-lib.dir}" />
    <copy file="${lib.dir}/${commons-pool.lib}" todir="${pmmda-ex-lib.dir}" />
    <copy file="${lib.dir}/${forms.lib}" todir="${pmmda-ex-lib.dir}" />
    <copy file="${lib.dir}/${jcalendar.lib}" todir="${pmmda-ex-lib.dir}" />
    <copy file="${lib.dir}/${glazedlists.lib}" todir="${pmmda-ex-lib.dir}" />
    <copy file="${lib.dir}/${ojb.lib}" todir="${pmmda-ex-lib.dir}" />
    <copy file="${lib.dir}/${mysql-connector.lib}" todir="${pmmda-ex-lib.dir}" />
    <copy file="${lib.dir}/jbossall-client.jar" todir="${pmmda-ex-lib.dir}" />
    <copy file="${dog-lib.dir}/${dog.name}-${dog.version}.jar" todir="${pmmda-ex-lib.dir}" />
    <copy file="${scripts.dir}/dist/tutorial-users/build.properties" todir="${pmmda-ex.dir}" />
    <copy file="${basedir}/build-examples.xml" todir="${pmmda-ex.dir}" />
  </target>

  <target name="javadoc" depends="init" description="generates javadoc for the project">
    <mkdir dir="${site.api.dir}" />
    <javadoc destdir="${site.api.dir}" packagenames="ch.bbv.*" classpath="${build.dir}" classpathref="application.classpath" access="private" author="true" version="true" use="true" source="1.5" windowtitle="pmMDA API">
      <sourcepath>
        <pathelement path="${src.pmmda.dir}/" />
        <pathelement path="${src.dog.dir}/" />
        <pathelement path="${src.documentor.dir}/" />
      </sourcepath>
      <taglet name="ch.bbv.documentor.taglets.PreTaglet" path="${build.dir}" />
      <taglet name="ch.bbv.documentor.taglets.PostTaglet" path="${build.dir}" />
      <taglet name="ch.bbv.documentor.taglets.InvTaglet" path="${build.dir}" />
    </javadoc>
  </target>

  <target name="clean-docs" depends="init" description="remove all generated document and metrics artifacts">
    <delete dir="${site.api.dir}" />
    <mkdir dir="${site.api.dir}" />
    <delete dir="${site.quality.dir}" />
    <mkdir dir="${site.quality.dir}" />
  </target>

  <target name="metrics" depends="init" description="generates quality metrics on the project">
    <mkdir dir="${site.quality.dir}" />
    <javadoc destdir="${site.quality.dir}" doclet="com.sun.tools.doclets.doccheck.DocCheck" docletpathref="scripts.classpath" packagenames="ch.bbv.*" classpath="${build.dir}" classpathref="application.classpath" source="1.5" protected="true">
      <sourcepath>
        <pathelement path="${src.pmmda.dir}/" />
        <pathelement path="${src.dog.dir}/" />
        <pathelement path="${src.documentor.dir}/" />
      </sourcepath>
    </javadoc>
    <java classname="javancss.Main" fork="true">
      <classpath refid="scripts.classpath" />
      <arg value="-ncss" />
      <arg value="-all" />
      <arg value="-recursive" />
      <arg value="-xml" />
      <arg value="-out" />
      <arg path="${site.quality.dir}/javancss-report.xml" />
      <arg path="${src.pmmda.dir}" />
      <arg path="${src.dog.dir}" />
      <arg path="${src.documentor.dir}" />
    </java>
    <xslt in="${site.quality.dir}/javancss-report.xml" out="${site.quality.dir}/javancss-report.html" style="${scripts.dir}/resources/xslt/javancss2html.xsl" />
    <taskdef name="pmd" classname="net.sourceforge.pmd.ant.PMDTask">
      <classpath>
        <path refid="scripts.classpath" />
      </classpath>
    </taskdef>
    <pmd rulesetfiles="${pmdrules.dir}/basic.xml,${pmdrules.dir}/braces.xml,
                       ${pmdrules.dir}/codesize.xml,${pmdrules.dir}/coupling.xml,
                       ${pmdrules.dir}/naming.xml,${pmdrules.dir}/design.xml,
                       ${pmdrules.dir}/strings.xml,${pmdrules.dir}/imports.xml,
                       ${pmdrules.dir}/unusedcode.xml" failonerror="no">
      <formatter type="xml" toFile="${site.quality.dir}/pmd-report.xml" />
      <fileset dir="${src.dir}/java-framework">
        <include name="**/*.java" />
      </fileset>
    </pmd>
    <xslt in="${site.quality.dir}/pmd-report.xml" out="${site.quality.dir}/pmd-report.html" style="${scripts.dir}/resources/xslt/pmd-report.xsl" />
    <jdepend outputfile="${site.quality.dir}/jdepend-report.xml" format="xml">
      <classespath>
        <pathelement location="${build.dir}" />
      </classespath>
      <classpath>
        <pathelement location="${build.dir}" />
        <pathelement location="${lib.dir}" />
      </classpath>
    </jdepend>
    <xslt in="${site.quality.dir}/jdepend-report.xml" out="${site.quality.dir}/jdepend-report.html" style="${scripts.dir}/resources/xslt/jdepend.xsl" />
  </target>

  <target name="sourceforge-without-documentation" depends="dist-init, clean, compile-dist, dog-dist, pmmda-dist, pmmda-examples" description="Generates the pmMDA sourceforge site (without web site)">
  </target>

  <target name="generate-docs" depends="dist-init, clean-docs" description="Generates the site related documents (before running forrest)">
    <antcall target="javadoc" />
    <antcall target="metrics" />
  </target>

  <target name="sourceforge" depends="sourceforge-without-documentation, generate-docs, site" description="Generates the pmMDA sourceforge site including web site">
    <echo message="generate sourceforge web site (forrest is mandatory)" />
  </target>
</project>